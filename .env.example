# Archivo de configuración de entorno para Google Sheets
# Copia este archivo como .env y reemplaza los valores con tus credenciales reales

# ID del Spreadsheet de Google Sheets
GOOGLE_SHEETS_ID=TU_GOOGLE_SHEETS_ID_AQUI

# Credenciales de GCP (variables individuales)
GCP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_PRIVATE_KEY_AQUI\n-----END PRIVATE KEY-----\n"
GCP_CLIENT_EMAIL=tu-service-account@tu-project.iam.gserviceaccount.com
GCP_PROJECT_ID=tu-project-id
GCP_PRIVATE_KEY_ID=tu-private-key-id
GCP_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GCP_TOKEN_URI=https://oauth2.googleapis.com/token
GCP_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs

# O usa GCP_SERVICE_ACCOUNT_JSON si tienes el JSON completo
# GCP_SERVICE_ACCOUNT_JSON={"type": "service_account", ... }